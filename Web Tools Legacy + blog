<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Thrift Shop Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#4f46e5',
            secondary: '#818cf8',
            accent: '#c7d2fe'
          },
          animation: {
            'gradient-x': 'gradient-x 15s ease infinite',
          },
          keyframes: {
            'gradient-x': {
              '0%, 100%': {
                'background-size': '200% 200%',
                'background-position': 'left center'
              },
              '50%': {
                'background-size': '200% 200%',
                'background-position': 'right center'
              },
            },
          }
        }
      }
    }
  </script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
    
    body {
      font-family: 'Inter', sans-serif;
      /* Dark animated gradient background */
      background: linear-gradient(-45deg, #0f172a, #1e1b4b, #312e81, #0f172a);
      background-size: 400% 400%;
      animation: gradient 15s ease infinite;
      overflow: hidden; /* Prevent scrollbars from particles */
      margin: 0;
    }

    @keyframes gradient {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    /* Canvas for particles sits behind everything */
    #particles-js {
      position: fixed;
      width: 100%;
      height: 100%;
      top: 0;
      left: 0;
      z-index: -1;
    }

    .card {
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      background: rgba(15, 23, 42, 0.6); /* Dark glass */
      border: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
      transition: all 0.3s ease;
    }

    .btn {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }
    
    /* Subtle glow effect on hover */
    .btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 0 15px rgba(99, 102, 241, 0.5);
    }
    .btn:active {
      transform: translateY(0);
    }
  </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4">
  
  <!-- Particle Canvas -->
  <canvas id="particles-js"></canvas>

  <div class="w-full max-w-md z-10">
    <div class="card rounded-2xl p-8">
      <div class="text-center mb-10">
        <h1 class="text-3xl font-bold text-white mb-2 tracking-tight drop-shadow-md">Thrift Shop Manager</h1>
        <p class="text-indigo-300 font-light">Access your tools and resources</p>
      </div>
      
      <div class="space-y-6">
        <button 
          onclick="handleDailyLogClick()"
          class="btn w-full h-16 text-lg font-semibold bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white rounded-xl shadow-lg flex items-center justify-center"
        >
          <i class="fas fa-calendar-alt mr-3"></i>
          Daily log in 2026
          <i class="fas fa-arrow-right ml-3 opacity-70"></i>
        </button>
        
        <button 
          onclick="handlePolicyClick()"
          class="btn w-full h-12 text-sm font-medium border border-indigo-400/30 text-indigo-100 hover:bg-indigo-500/20 hover:border-indigo-400/60 rounded-lg flex items-center justify-center backdrop-blur-sm"
        >
          <i class="fas fa-users mr-2"></i>
          New volunteer policy for 2026
        </button>

        <!-- New Blog Button -->
        <button 
          onclick="handleBlogClick()"
          class="btn w-full h-12 text-sm font-medium bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-400 hover:to-amber-400 text-white rounded-lg shadow-lg flex items-center justify-center"
        >
          <img src="https://imgs.search.brave.com/UcGBr7HVlyxIutgT_3pqk_IaBegVENzJbdVw9bNLLxk/rs:fit:860:0:0:0/g:ce/aHR0cHM6Ly9pbWFn/ZXMuaWNvbi1pY29u/cy5jb20vMjEwOC9Q/TkcvNTEyL2Jsb2dn/ZXJfaWNvbl8xMzA5/NzYucG5n" alt="Blog Icon" class="w-5 h-5 mr-2 object-contain">
          Blog
        </button>
        
        <!-- Flex container for the two bottom buttons -->
        <div class="flex gap-4 w-full">
          <button 
            onclick="handleNewTabClick()"
            class="btn flex-1 h-12 text-sm font-medium bg-slate-700/50 text-indigo-100 hover:bg-slate-700/80 rounded-lg flex items-center justify-center border border-white/5"
          >
            New tab
          </button>

          <button 
            onclick="handleAiClick()"
            class="btn w-12 h-12 bg-gradient-to-br from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white rounded-lg shadow-lg flex items-center justify-center border border-white/10"
            title="Open Google AI Mode"
          >
            <i class="fas fa-robot text-lg"></i>
          </button>
        </div>
      </div>
      
      <div class="mt-12 text-center">
        <!-- Version updated to 4.7 -->
        <p class="text-xs text-indigo-400/60 uppercase tracking-widest font-semibold">
          Thrift Shop Management System v5.3
        </p>
      </div>
    </div>
  </div>

  <script>
    // --- Core Functionality ---
    function handleDailyLogClick() {
      window.open("https://docs.google.com/forms/d/e/1FAIpQLSfM1R0xopH7P0To6rJM-8uA6sHxpmd94DOtZzeqCBJTOsJ7FA/viewform?usp=publish-editor");
    }

    function handlePolicyClick() {
      window.open("https://docs.google.com/forms/d/e/1FAIpQLSdWsudtnHu4waMEwvOjPjBghEAEfaAmPrlM-Lieqk7UGsJcDg/viewform?usp=publish-editor", "_blank");
    }

    function handleNewTabClick() {
      window.open("https://www.google.com/", "_blank");
    }

    function handleAiClick() {
      window.open("https://www.google.com/search?sca_esv=cd8b0170047d7d59&sxsrf=AE3TifM0Jdanj64vOiO9Ngvy6Rzc-92nYQ%3A1767411529503&source=hp&ei=SY9YaaPWHJ_S2roPqrawwAE&iflsig=AOw8s4IAAAAAaVidWRFYy-gRB6-oFdspYEge0oPiqOT5&aep=22&udm=50&ved=2ahUKEwjUoNeDue6RAxUsslYBHY3YB1YQoo4PegYIAQgAEAA&oq=&gs_lp=Egdnd3Mtd2l6IgBIAFAAWABwAHgAkAEAmAEAoAEAqgEAuAEByAEAmAIAoAIAmAMAkgcAoAcAsgcAuAcAwgcAyAcAgAgA&sclient=gws-wiz", "_blank");
    }

    function handleBlogClick() {
      window.open("https://coolthriftitems.blogspot.com/", "_blank");
    }

    // --- Particle Animation Logic ---
    const canvas = document.getElementById("particles-js");
    const ctx = canvas.getContext("2d");
    
    let particlesArray;
    
    // Set canvas size
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    
    // Handle resize
    window.addEventListener('resize', () => {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
      init();
    });

    class Particle {
      constructor() {
        this.x = Math.random() * canvas.width;
        this.y = Math.random() * canvas.height;
        this.directionX = (Math.random() * 0.4) - 0.2;
        this.directionY = (Math.random() * 0.4) - 0.2;
        this.size = Math.random() * 2 + 1;
        this.color = '#818cf8'; // Secondary color
      }
      // Draw individual particle
      draw() {
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2, false);
        ctx.fillStyle = this.color;
        ctx.fill();
      }
      // Check particle position, check mouse position, move the particle, draw the particle
      update() {
        if (this.x > canvas.width || this.x < 0) {
          this.directionX = -this.directionX;
        }
        if (this.y > canvas.height || this.y < 0) {
          this.directionY = -this.directionY;
        }
        this.x += this.directionX;
        this.y += this.directionY;
        this.draw();
      }
    }

    function init() {
      particlesArray = [];
      // Increased density by lowering the divisor (was 15000, now 7000)
      let numberOfParticles = (canvas.height * canvas.width) / 7000; 
      for (let i = 0; i < numberOfParticles; i++) {
        particlesArray.push(new Particle());
      }
    }

    // Animation Loop
    function animate() {
      requestAnimationFrame(animate);
      ctx.clearRect(0, 0, innerWidth, innerHeight);

      for (let i = 0; i < particlesArray.length; i++) {
        particlesArray[i].update();
      }
      connect();
    }

    // Draw lines between particles that are close enough
    function connect() {
      let opacityValue = 1;
      for (let a = 0; a < particlesArray.length; a++) {
        for (let b = a; b < particlesArray.length; b++) {
          let distance = ((particlesArray[a].x - particlesArray[b].x) * (particlesArray[a].x - particlesArray[b].x)) + 
                         ((particlesArray[a].y - particlesArray[b].y) * (particlesArray[a].y - particlesArray[b].y));
          if (distance < (canvas.width/7) * (canvas.height/7)) {
            opacityValue = 1 - (distance / 20000);
            ctx.strokeStyle = 'rgba(129, 140, 248,' + opacityValue + ')'; // Secondary color with opacity
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(particlesArray[a].x, particlesArray[a].y);
            ctx.lineTo(particlesArray[b].x, particlesArray[b].y);
            ctx.stroke();
          }
        }
      }
    }

    init();
    animate();

  </script>
</body>
</html>
